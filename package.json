{
  "name": "git-ui-native",
  "version": "0.4.2",
  "private": true,
  "description": "Finally, a proper Git UI for VS Code. Inspired by JetBrains IDEs.",
  "icon": "assets/marketplace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/andreymyssak/vscode-git-ui.git"
  },
  "homepage": "https://github.com/andreymyssak/vscode-git-ui#readme",
  "bugs": {
    "url": "https://github.com/andreymyssak/vscode-git-ui/issues"
  },
  "keywords": [
    "git",
    "git ui",
    "git gui",
    "git browser",
    "git graph",
    "git history",
    "git log",
    "graph",
    "history",
    "commits",
    "commit graph",
    "commit history",
    "branches",
    "tags",
    "worktree",
    "worktrees",
    "checkout",
    "diff",
    "compare",
    "merge",
    "rebase",
    "cherry-pick",
    "squash",
    "source control",
    "scm",
    "version control",
    "jetbrains",
    "intellij"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.10.0 <27",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.0 <13",
      "onFail": "error"
    }
  },
  "scripts": {
    "ai:install": "apm install --frozen",
    "ai:audit": "apm audit --ci",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run architecture:check && npm run test:local && npm run upstream:verify",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.webview.json && tsc -p tsconfig.test.json && tsc -p tsconfig.vitest.json && tsc -p tsconfig.scripts.json",
    "compatibility:check": "node scripts/test/vscode-compatibility.ts",
    "compatibility:insiders": "node scripts/test/vscode-compatibility.ts --insiders",
    "build": "node scripts/build/extension.ts && vite build",
    "build:vscode-tests": "node scripts/test/build-vscode-tests.ts",
    "test:unit": "vitest run --config vitest.config.mts --project unit",
    "test:integration": "vitest run --config vitest.config.mts --project integration",
    "architecture:check": "depcruise src --config .dependency-cruiser.cjs --ts-config tsconfig.webview.json && steiger src/webview",
    "graph": "node -e \"require('node:fs').mkdirSync('.artifacts', { recursive: true })\" && depcruise src --config .dependency-cruiser.cjs --ts-config tsconfig.webview.json --output-type mermaid --output-to .artifacts/dependencies.mmd",
    "demo": "node scripts/dev/create-demo.ts",
    "test": "npm run check",
    "upstream:verify": "node scripts/upstream/verify.ts",
    "upstream:reproduce": "node scripts/upstream/reproduce.ts",
    "upstream:report": "node scripts/upstream/report.ts",
    "upstream:prepare": "node scripts/upstream/update.ts",
    "package": "npm run build && vsce package --no-dependencies --out .artifacts/git-ui-native.vsix && npm run package:verify",
    "package:verify": "node scripts/package/verify.ts",
    "release:preview": "release-it --dry-run",
    "release:prepare": "release-it",
    "release:validate": "npm run check && npm run test:browser && npm run test:vscode && npm run test:installed",
    "release": "release-it --config .release-it.publish.cjs --no-increment",
    "release:marketplace": "npm run package:verify && vsce publish --packagePath .artifacts/git-ui-native.vsix",
    "test:installed": "npm run package && npm run build:vscode-tests && node scripts/test/run-vscode-tests.ts --installed",
    "test:local": "vitest run --config vitest.config.mts",
    "test:component": "vitest run --config vitest.config.mts --project component",
    "test:browser": "npm run build && playwright test",
    "test:vscode": "npm run package && npm run build:vscode-tests && vscode-test --label native && node scripts/test/run-vscode-tests.ts --restricted"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@tanstack/react-virtual": "3.14.13",
    "@vscode-elements/elements": "2.5.1",
    "@vscode/codicons": "0.0.45",
    "clsx": "2.1.1",
    "jsonc-parser": "3.3.1",
    "picomatch": "4.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@eslint/js": "10.0.1",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@playwright/test": "1.63.0",
    "@release-it/conventional-changelog": "12.0.2",
    "@rolldown/plugin-babel": "0.2.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.110.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.5.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "release-it": "21.1.0",
    "steiger": "0.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "yauzl": "3.4.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign": false,
    "fsevents": false
  },
  "displayName": "Git UI",
  "publisher": "andreymyssak",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.111.0"
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onView:gitUI.log",
    "onView:gitUI.changes"
  ],
  "categories": [
    "SCM Providers"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "gitUI",
          "title": "Git UI",
          "icon": "assets/git-ui-native.svg"
        }
      ]
    },
    "views": {
      "gitUI": [
        {
          "id": "gitUI.log",
          "name": "Git UI",
          "type": "webview"
        }
      ],
      "scm": [
        {
          "id": "gitUI.changes",
          "name": "Git UI Changes",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Git UI",
      "properties": {
        "gitUI.history.optimizeRepository": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Allow Git UI to maintain Git's local commit-graph cache in the background after loading history. Requires Git 2.24 or later and a trusted workspace. Skips shallow and partial clones and repositories with `core.commitGraph=false`. Disable to prevent Git UI from writing this cache."
        }
      }
    },
    "commands": [
      {
        "command": "gitUI.show-output",
        "title": "Show Output",
        "category": "Git UI"
      },
      {
        "command": "gitUI.merge-branch",
        "title": "Merge",
        "enablement": "!logOperationBusy && refCanIntegrate"
      },
      {
        "command": "gitUI.rebase-branch",
        "title": "Rebase",
        "enablement": "!logOperationBusy && refCanIntegrate"
      },
      {
        "command": "gitUI.create-worktree",
        "title": "New Worktree",
        "enablement": "!logOperationBusy && refKind != tag"
      },
      {
        "command": "gitUI.update-branch",
        "title": "Update",
        "enablement": "!logOperationBusy && refCanUpdate"
      },
      {
        "command": "gitUI.checkout",
        "title": "Checkout",
        "enablement": "!logOperationBusy && refKind != tag && !refCurrent"
      },
      {
        "command": "gitUI.create-branch",
        "title": "New Branch",
        "enablement": "!logOperationBusy"
      },
      {
        "command": "gitUI.create-branch-checkout",
        "title": "New Branch and Checkout",
        "enablement": "!logOperationBusy"
      },
      {
        "command": "gitUI.rename-branch",
        "title": "Rename",
        "enablement": "!logOperationBusy && refKind == local"
      },
      {
        "command": "gitUI.delete-branch",
        "title": "Delete",
        "enablement": "!logOperationBusy && refKind == local && !refCurrent"
      },
      {
        "command": "gitUI.delete-branches",
        "title": "Delete",
        "enablement": "!logOperationBusy && refsCanDelete && refSelectionCount > 1"
      },
      {
        "command": "gitUI.copy-branch",
        "title": "Copy Branch Name"
      },
      {
        "command": "gitUI.copy-sha",
        "title": "Copy Revision Number"
      },
      {
        "command": "gitUI.cherry-pick-files",
        "title": "Cherry-Pick Selected Changes",
        "enablement": "isWorkspaceTrusted && fileCanApplyChanges && fileSelectionCount > 0"
      },
      {
        "command": "gitUI.revert-files",
        "title": "Revert Selected Changes",
        "enablement": "isWorkspaceTrusted && fileCanApplyChanges && fileSelectionCount > 0"
      },
      {
        "command": "gitUI.cherry-pick",
        "title": "Cherry-Pick",
        "enablement": "!logOperationBusy && commitCanCherryPick"
      },
      {
        "command": "gitUI.edit-commit-message",
        "title": "Edit Commit Message…",
        "enablement": "!logOperationBusy && commitCanEdit"
      },
      {
        "command": "gitUI.squash-commits",
        "title": "Squash Commits…",
        "enablement": "!logOperationBusy && commitCanSquash"
      },
      {
        "command": "gitUI.branch-from-commit",
        "title": "New Branch",
        "enablement": "!logOperationBusy"
      },
      {
        "command": "gitUI.tag-from-commit",
        "title": "New Tag…",
        "enablement": "!logOperationBusy"
      },
      {
        "command": "gitUI.drop-commits",
        "title": "Drop Commits…",
        "enablement": "!logOperationBusy && commitCanDrop"
      },
      {
        "command": "gitUI.open-worktree-new",
        "title": "Open in New Window",
        "enablement": "worktreeCanOpen"
      },
      {
        "command": "gitUI.open-worktree-current",
        "title": "Open in This Window",
        "enablement": "worktreeCanOpen"
      },
      {
        "command": "gitUI.delete-worktrees",
        "title": "Delete",
        "enablement": "!logOperationBusy && worktreeCanDelete"
      },
      {
        "command": "gitUI.refresh-changes",
        "title": "Refresh Changes",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy",
        "icon": "$(refresh)"
      },
      {
        "command": "gitUI.check-all",
        "title": "Check All Files",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.uncheck-all",
        "title": "Uncheck All Files",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.commit-checked",
        "title": "Commit Checked Files",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy && gitUI.changesHasChecked",
        "icon": "$(check)"
      },
      {
        "command": "gitUI.stash-checked",
        "title": "Stash Checked Files",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy && gitUI.changesHasChecked",
        "icon": "$(archive)"
      },
      {
        "command": "gitUI.show-changes",
        "title": "Stash Changes…",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy",
        "icon": "$(archive)"
      },
      {
        "command": "gitUI.open-stash-change",
        "title": "Open Saved Changes",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.apply-stash",
        "title": "Apply Stash",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.apply-stash-files",
        "title": "Apply Selected Files",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.delete-stash",
        "title": "Delete Stash…",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.discard-working-change",
        "title": "Discard Changes",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.commit-selected",
        "title": "Commit",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.stash-selected",
        "title": "Stash",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.copy-relative-path",
        "title": "Copy Relative Path",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.rollback-selected",
        "title": "Rollback…",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.rename-stash",
        "title": "Rename Stash…",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.delete-stash-files",
        "title": "Delete Selected Files…",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.annotate-blame",
        "title": "Git UI: Annotate with Git Blame",
        "enablement": "isWorkspaceTrusted && config.git.enabled && gitOpenRepositoryCount > 0 && (resourceScheme == file || resourceScheme == git)"
      },
      {
        "command": "gitUI.close-blame",
        "title": "Git UI: Close Git Blame",
        "enablement": "isWorkspaceTrusted && config.git.enabled && gitOpenRepositoryCount > 0 && (resourceScheme == file || resourceScheme == git)"
      },
      {
        "command": "gitUI.open-blame-commit",
        "title": "Open Blame Commit in Git UI",
        "enablement": "isWorkspaceTrusted && config.git.enabled"
      },
      {
        "command": "gitUI.open-current-blame-commit",
        "title": "Git UI: Open Line Commit",
        "enablement": "isWorkspaceTrusted && config.git.enabled && gitOpenRepositoryCount > 0 && (resourceScheme == file || resourceScheme == git) && gitUI.blame-enabled"
      },
      {
        "command": "gitUI.resolve-conflicts",
        "title": "Resolve in Merge Editor",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.accept-current",
        "title": "Accept All Current",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.accept-incoming",
        "title": "Accept All Incoming",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.stage-files",
        "title": "Stage Changes",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.unstage-files",
        "title": "Unstage Changes",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.delete-files",
        "title": "Delete",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.reveal-in-explorer",
        "title": "Reveal in Explorer View",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.reveal-in-os.mac",
        "title": "Reveal in Finder",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.reveal-in-os.windows",
        "title": "Reveal in File Explorer",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.reveal-in-os.linux",
        "title": "Open Containing Folder",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && !gitUI.sourceControlBusy"
      },
      {
        "command": "gitUI.pull",
        "title": "Pull",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && gitUI.changesHasRepository"
      },
      {
        "command": "gitUI.push",
        "title": "Push",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && gitUI.changesHasRepository"
      },
      {
        "command": "gitUI.checkout-branch",
        "title": "Checkout",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && gitUI.changesHasRepository"
      },
      {
        "command": "gitUI.new-branch",
        "title": "New Branch",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && gitUI.changesHasRepository"
      },
      {
        "command": "gitUI.new-branch-checkout",
        "title": "New Branch and Checkout",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && gitUI.changesHasRepository"
      },
      {
        "command": "gitUI.fetch",
        "title": "Fetch",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && gitUI.changesHasRepository"
      },
      {
        "command": "gitUI.merge-current",
        "title": "Merge",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && gitUI.changesHasRepository"
      },
      {
        "command": "gitUI.rebase-current",
        "title": "Rebase",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && gitUI.changesHasRepository"
      },
      {
        "command": "gitUI.new-branch-from",
        "title": "New Branch and Checkout From",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && gitUI.changesHasRepository"
      },
      {
        "command": "gitUI.rename-current-branch",
        "title": "Rename",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && gitUI.changesHasRepository"
      },
      {
        "command": "gitUI.delete-local-branch",
        "title": "Delete Branch",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && gitUI.changesHasRepository"
      },
      {
        "command": "gitUI.delete-remote-branch",
        "title": "Delete Remote Branch",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && gitUI.changesHasRepository"
      },
      {
        "command": "gitUI.publish-branch",
        "title": "Publish Branch",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && gitUI.changesHasRepository"
      },
      {
        "command": "gitUI.create-tag",
        "title": "Create Tag",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && gitUI.changesHasRepository"
      },
      {
        "command": "gitUI.delete-tag",
        "title": "Delete Tag",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && gitUI.changesHasRepository"
      },
      {
        "command": "gitUI.delete-remote-tag",
        "title": "Delete Remote Tag",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && gitUI.changesHasRepository"
      },
      {
        "command": "gitUI.push-tags",
        "title": "Push Tags",
        "category": "Git UI",
        "enablement": "isWorkspaceTrusted && gitUI.changesHasRepository"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "gitUI.cherry-pick-files",
          "when": "webviewId == gitUI.log && (webviewSection == commit-file || webviewSection == commit-folder)",
          "group": "1_changes@1"
        },
        {
          "command": "gitUI.revert-files",
          "when": "webviewId == gitUI.log && (webviewSection == commit-file || webviewSection == commit-folder)",
          "group": "1_changes@2"
        },
        {
          "command": "gitUI.rebase-branch",
          "when": "webviewId == gitUI.log && webviewSection == branch && refSelectionCount == 1",
          "group": "2_integrate@1"
        },
        {
          "command": "gitUI.merge-branch",
          "when": "webviewId == gitUI.log && webviewSection == branch && refSelectionCount == 1",
          "group": "2_integrate@2"
        },
        {
          "command": "gitUI.create-worktree",
          "when": "webviewId == gitUI.log && webviewSection == branch && refSelectionCount == 1",
          "group": "2_worktree@1"
        },
        {
          "command": "gitUI.checkout",
          "when": "webviewId == gitUI.log && webviewSection == branch && refSelectionCount == 1",
          "group": "1_branch@1"
        },
        {
          "command": "gitUI.create-branch",
          "when": "webviewId == gitUI.log && webviewSection == branch && refSelectionCount == 1",
          "group": "1_branch@2"
        },
        {
          "command": "gitUI.create-branch-checkout",
          "when": "webviewId == gitUI.log && webviewSection == branch && refSelectionCount == 1",
          "group": "1_branch@3"
        },
        {
          "command": "gitUI.update-branch",
          "when": "webviewId == gitUI.log && webviewSection == branch && refSelectionCount == 1",
          "group": "1_branch@4"
        },
        {
          "command": "gitUI.rename-branch",
          "when": "webviewId == gitUI.log && webviewSection == branch && refSelectionCount == 1",
          "group": "2_manage@1"
        },
        {
          "command": "gitUI.delete-branch",
          "when": "webviewId == gitUI.log && webviewSection == branch && refSelectionCount == 1",
          "group": "2_manage@2"
        },
        {
          "command": "gitUI.delete-branches",
          "when": "webviewId == gitUI.log && webviewSection == branch && refSelectionCount > 1",
          "group": "2_manage@2"
        },
        {
          "command": "gitUI.copy-branch",
